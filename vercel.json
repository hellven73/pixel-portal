{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node build-vercel.mjs",
  "outputDirectory": "vercel-dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "https://hellven73-pixel-portal.onrender.com/$1"
    }
  ]
}
