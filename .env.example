# Local development only. Copy this to .env and fill in the shared secret.
# Generate a random secret of at least 32 characters; use the same value for both processes.
PROXY_SHARED_SECRET=
PROXY_ORIGIN=http://localhost:8081
DB_PATH=./data/portal.sqlite

# Optional AI: any provider implementing the OpenAI-compatible chat/completions API.
# These are server-only. Never put a real key in browser code or commit .env.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Set only for a local provider that does not require an API key:
AI_ALLOW_LOCAL=0
