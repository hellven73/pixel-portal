{
  "name": "pixel-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node dev.mjs",
    "check": "node --check server.mjs && node --check proxy.mjs && node --check browser.js && node --check app.js && node --check services.js && node --check sw.js",
    "test": "node --test server.test.mjs",
    "start:browser": "node --env-file-if-exists=.env proxy.mjs"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/libcurl-transport": "1.5.2",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
    "@mercuryworkshop/wisp-js": "0.4.1"
  }
}
